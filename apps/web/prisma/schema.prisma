// Prisma schema for bayes-iot-pipeline
// Phase 1: EnvReading
// Phase 2: Forecast, Anomaly (already defined so we don't migrate later)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Raw sensor reading from device (or simulator)
model EnvReading {
  id          String   @id @default(cuid())
  deviceUid   String
  receivedAt  DateTime @default(now())  // when our service wrote it
  capturedAt  DateTime                  // when device sampled it
  ingestedAt  DateTime                  // when ingest webhook received it
  tempC       Float
  humidity    Float
  pressureHpa Float?
  vocOhms     Float?
  probeTempC  Float?                    // DS18B20 waterproof probe (second temperature)

  // Idempotency: same device + same capture instant = same row
  @@unique([deviceUid, capturedAt])
  @@index([capturedAt])
  @@index([deviceUid, capturedAt])
}

// Forecast output (Phase 2)
// One row per (model, device, target_time)
model Forecast {
  id          String   @id @default(cuid())
  deviceUid   String
  modelName   String   // "prophet", "pymc-bayesian", "arima"
  modelVersion String  // "v1", "v2", etc.
  forecastAt  DateTime @default(now())  // when forecast was made
  targetAt    DateTime                  // time being forecasted
  tempC       Float                     // point estimate
  tempCLower  Float?                    // 90% credible/confidence interval lower
  tempCUpper  Float?                    // 90% credible/confidence interval upper
  humidity    Float?
  humidityLower Float?
  humidityUpper Float?

  @@unique([deviceUid, modelName, modelVersion, targetAt])
  @@index([deviceUid, targetAt])
  @@index([modelName, forecastAt])
}

// Anomaly flag (Phase 2)
model Anomaly {
  id          String   @id @default(cuid())
  deviceUid   String
  detectedAt  DateTime @default(now())
  capturedAt  DateTime  // when the anomalous reading was captured
  metric      String    // "temp_c", "humidity"
  observedValue Float
  expectedValue Float
  deviation   Float     // signed difference
  severity    String    // "low", "medium", "high"
  modelName   String    // which model flagged it

  @@index([deviceUid, detectedAt])
}

// A sensor node (one Swan + Notecard). Labels and sites drive the
// node -> site rollup on the dashboard. Rows are created automatically
// the first time a device posts; the label follows the Notehub serial
// number ("sn") when one is set for the device.
model Device {
  deviceUid String   @id
  label     String
  site      String   @default("Lab bench")
  sortOrder Int      @default(0)
  role      String   @default("room") // "frozen" turns on the freezer-failure alarm
  createdAt DateTime @default(now())
}

// A temperature alarm episode: opened when a rule trips, closed when the
// reading is safely back to normal. One open alarm per device and kind.
model Alarm {
  id          String    @id @default(cuid())
  deviceUid   String
  ruleId      String?   // the AlarmRule that opened it
  kind        String    // channel_condition, e.g. "water_rising"
  message     String
  value       Float?    // latest 5-minute mean, °C
  rate        Float?    // °C per minute between two 5-minute means
  triggeredAt DateTime
  clearedAt   DateTime?
  notified    Boolean   @default(false) // phone push accepted by ntfy

  @@index([deviceUid, kind, clearedAt])
  @@index([deviceUid, ruleId, clearedAt])
  @@index([triggeredAt])
}

// An alarm rule, edited on the dashboard. Checked after every reading.
model AlarmRule {
  id        String   @id @default(cuid())
  deviceUid String?  // null = every node
  channel   String   // "water", "air" or "humidity"
  condition String   // "above", "below", "rising" or "falling"
  threshold Float    // level in °C or %, or a rate per minute
  windowMin Int      @default(5) // averaging window: 1, 5 or 15 minutes
  enabled   Boolean  @default(true)
  push      Boolean  @default(true) // send a phone push through ntfy
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
